# PyReplay Trader — Environment Configuration
# Copy to .env and customize for your deployment

# ────────────────────────────────────────────────────────────────────────────
# Deployment Environment
# ────────────────────────────────────────────────────────────────────────────

# Environment: 'development' or 'production'
ENVIRONMENT=development

# Flask environment
FLASK_ENV=development

# ────────────────────────────────────────────────────────────────────────────
# Security (REQUIRED FOR PRODUCTION)
# ────────────────────────────────────────────────────────────────────────────

# Session encryption key (must be >= 32 characters for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production-12345678901234567890

# ────────────────────────────────────────────────────────────────────────────
# Redis Configuration
# ────────────────────────────────────────────────────────────────────────────

# Redis connection URL
# Local: redis://localhost:6379/0
# Docker: redis://redis:6379/0
# Upstash (managed): redis://default:password@host:port
REDIS_URL=redis://localhost:6379/0

# Session TTL in seconds (default: 2 hours)
SESSION_TTL=7200

# ────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ────────────────────────────────────────────────────────────────────────────

# Host to bind to (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Port to listen on
PORT=5000

# ────────────────────────────────────────────────────────────────────────────
# Logging
# ────────────────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────────────────────
# MT5 Configuration (Optional)
# ────────────────────────────────────────────────────────────────────────────

# MT5 bridge host (if using MT5 data provider)
MT5_HOST=localhost

# MT5 bridge port
MT5_PORT=18812

# ────────────────────────────────────────────────────────────────────────────
# Production Render Deployment
# ────────────────────────────────────────────────────────────────────────────

# For Render, set:
# ENVIRONMENT=production
# SECRET_KEY=<generated 32+ character key>
# REDIS_URL=<Upstash Redis URL from Render environment>
# LOG_LEVEL=INFO (not DEBUG in production)

# Note: PORT will be automatically set by Render via environment variable
